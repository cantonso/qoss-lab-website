---
import Base from '../layouts/Base.astro';
import NewsTable from '../components/NewsTable.astro';
import Bib from '../components/Bib.astro';
import ProjectCards from '../components/ProjectCards.astro';
import { getEntry, render } from 'astro:content';
import news from '../data/news.json';
import pubs from '../data/publications.json';
import { byDateDesc } from '../lib/md.js';
const page = await getEntry('pages', 'home');
const { Content } = await render(page);
const d = page.data;
const years = pubs.map(p => p.year).filter(y => /^\d{4}$/.test(y)).sort().reverse();
const latest = pubs.filter(p => p.year === years[0]);
---
<Base current="about">
<div class="post-header"><h1 class="post-title"><b>Quantum Optics</b> in the Solid State</h1><p class="desc">{d.subtitle}</p></div>
<figure class="banner" style="margin-inline:0"><img class="bimg" src={d.banner_image} alt="Optical setup in the QOSS laboratory"><figcaption class="cap"><strong>{d.banner_caption}</strong><span>QOSS lab · UAM Madrid</span></figcaption></figure>
<div class="about">
  <div class="prose"><Content /></div>
  <aside class="profile"><div class="address" style="margin-top:0">Contact:<br>Dept. Physics of Materials<br>Faculty of Science<br>Univ. Autónoma de Madrid<br>28049 Madrid, Spain<br>carlos.anton [at] uam.es</div></aside>
</div>
<h2 class="sec">news <a href="/news/">all news →</a></h2>
<NewsTable items={[...news].sort(byDateDesc).slice(0, 6)} />
<h2 class="sec">selected publications <a href="/publications/">all publications →</a></h2>
<ol class="bib">{latest.map(p => <Bib p={p} />)}</ol>
<h2 class="sec">current projects <a href="/research/">research →</a></h2>
<ProjectCards />
</Base>
