---
import Base from '../../layouts/Base.astro';
import LangBar from '../../components/LangBar.astro';
import { getEntry, render } from 'astro:content';
const page = await getEntry('pages', 'teaching');
const { Content } = await render(page);
---
<Base title={page.data.title} current="teaching" lang="en" description="Courses, lectures and student projects (TFG, TFM, prácticas) in experimental quantum optics at UAM.">
<LangBar en="/teaching/" es="/teaching/es/" active="en" />
<div class="post-header"><h1 class="post-title">{page.data.title}</h1></div>
<div class="prose"><Content /></div>
</Base>
